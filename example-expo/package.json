{
  "name": "react-native-nitro-google-signin-example-expo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client --port 8082",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "android": "expo run:android --port 8082",
    "ios": "expo run:ios --port 8082",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "file:..",
    "react-native-nitro-modules": "0.37.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
